@@ -0,0 +1,17 @@
+(ns bluegenes.reagent-compat
+  "Reagent 2.0 removed reagent.dom/dom-node (React 19 has no findDOMNode), but
+  im-tables 0.16 still calls it (head/controls.cljs force-close and
+  components/bootstrap.cljs Tooltip). This puts a stand-in in its place: the
+  first DOM node below the component, found through the fiber."
+  (:require [reagent.dom]))
+
+(defn dom-node
+  "The first DOM element rendered by the class component `this`, or nil."
+  [^js this]
+  (loop [fiber (.-_reactInternals this)]
+    (cond
+      (nil? fiber) nil
+      (instance? js/Element (.-stateNode fiber)) (.-stateNode fiber)
+      :else (recur (.-child fiber)))))
+
+(js* "(reagent.dom.dom_node = ~{})" dom-node)
